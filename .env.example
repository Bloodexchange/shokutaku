# Скопируйте в .env для локального запуска. На Vercel задайте те же переменные в Settings → Environment Variables.

# Строка подключения Neon Postgres (Vercel → Storage → Neon подставит её сама как DATABASE_URL)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Случайная строка от 32 символов: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Вход администратора (сайт /admin и Telegram‑бот). Пароль хранится ТОЛЬКО как bcrypt‑хеш:
#   npm run hash-password -- "ваш-пароль"
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=

# Ключ Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Необязательно: модели через запятую, перебираются по очереди
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-3.5-flash

# Telegram‑бот администратора (токен от @BotFather) и секрет вебхука (любая случайная строка)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Необязательно: публичный адрес сайта, например https://shokutaku.vercel.app
# PUBLIC_URL=
